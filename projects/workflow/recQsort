def qsort(list):
    '''

    '''

    if (len(list) == 2):
        if (list[0] > list[1]):
            list[0], list[1] = list[1], list[0]
        return list
    elif (len(list) > 2):
        average = list[len(list) // 2]
        small = []
        equal = []
        large = []
        for i in list:
            if (i < average):
                small.append(i)
            elif (i > average):
                large.append(i)
            else:
                equal.append(i)
        print(small, equal, large)
        return qsort(small) + equal + qsort(large)
    else:
        return list

